# Paths are resolved relative to HEALTH_PROJECT_ROOT when they are not absolute.
HEALTH_PROJECT_ROOT=.
HEALTH_DATABASE_PATH=data/health.duckdb
HEALTH_CONFIG_DIR=config
HEALTH_RAW_DIR=data/raw
HEALTH_EXPORT_DIR=data/exports
HEALTH_SNAPSHOT_DIR=data/snapshots

# Provider credentials belong in .env or a secret manager, never in Git.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
